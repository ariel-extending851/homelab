# Example structure for k8s/apps/alloy/secret.yaml.
#
# Workflow:
#   1. cp secret.yaml.example /tmp/alloy-secret.yaml
#   2. Replace placeholder values with real Grafana Cloud credentials.
#   3. sops -e /tmp/alloy-secret.yaml > k8s/apps/alloy/secret.yaml
#   4. Verify: sops -d k8s/apps/alloy/secret.yaml | head
#   5. shred -u /tmp/alloy-secret.yaml
#   6. Add `- secret.yaml` to k8s/apps/alloy/kustomization.yaml.
#
# The block-sops pre-commit hook rejects unencrypted `secret.yaml` under
# k8s/apps/*. The age recipient matches .sops.yaml:
#   age18mumpukzfug863dw7j3w2tntfd6y8nf34hzx07u2fep633mprqmqc3myja
#
# See docs/runbooks/alloy-troubleshooting.md for token rotation.

apiVersion: v1
kind: Secret
metadata:
  name: alloy-grafana-cloud
  namespace: alloy
  annotations:
    # Apply before the DaemonSet — envFrom would otherwise miss on first sync.
    argocd.argoproj.io/sync-wave: "-1"
type: Opaque
stringData:
  # Secrets — encrypted by SOPS, mounted into the pod via envFrom.
  GRAFANA_CLOUD_PROM_URL: "https://prometheus-prod-XX-prod-REGION-X.grafana.net/api/prom/push"
  GRAFANA_CLOUD_LOKI_URL: "https://logs-prod-XXX.grafana.net/loki/api/v1/push"
  GRAFANA_CLOUD_USER: "REPLACE_WITH_INSTANCE_ID"
  GRAFANA_CLOUD_TOKEN: "REPLACE_WITH_glc_eyJ..."
  # Bucket name comes from `terraform output -raw observability_bucket_id`.
  # Not strictly secret, but kept here so a single source of truth feeds
  # the pod via the single envFrom — no separate ConfigMap to keep in sync.
  ALLOY_S3_BUCKET: "REPLACE_WITH_observability_bucket_id_OUTPUT"
