# Example structure for k8s/apps/promtail/secret.yaml.
#
# Workflow:
#   1. cp secret.yaml.example /tmp/promtail-secret.yaml
#   2. Replace placeholder values with real Grafana Cloud Loki credentials.
#      (Same Loki instance + token used by k8s/apps/alloy/secret.yaml when
#       AWS Full is active — they share the Grafana Cloud account.)
#   3. sops -e /tmp/promtail-secret.yaml > k8s/apps/promtail/secret.yaml
#   4. Verify: sops -d k8s/apps/promtail/secret.yaml | head
#   5. shred -u /tmp/promtail-secret.yaml
#   6. Add `- secret.yaml` to k8s/apps/promtail/kustomization.yaml.
#
# The block-sops pre-commit hook rejects unencrypted `secret.yaml` under
# k8s/apps/*. The age recipient matches .sops.yaml:
#   age18mumpukzfug863dw7j3w2tntfd6y8nf34hzx07u2fep633mprqmqc3myja

apiVersion: v1
kind: Secret
metadata:
  name: promtail-grafana-cloud
  namespace: promtail
  annotations:
    # Apply before the DaemonSet — envFrom would otherwise miss on first sync.
    argocd.argoproj.io/sync-wave: "-1"
type: Opaque
stringData:
  # Loki push endpoint (Grafana Cloud free tier — same as Alloy uses).
  GRAFANA_CLOUD_LOKI_URL: "https://logs-prod-XXX.grafana.net/loki/api/v1/push"
  GRAFANA_CLOUD_USER: "REPLACE_WITH_INSTANCE_ID"
  GRAFANA_CLOUD_TOKEN: "REPLACE_WITH_glc_eyJ..."
