# ENV
.*env*

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfstate*.backup
*.tfvars
*.tfvars.json
tfplan
terraform.tfvars

# Ignorar pasta de builds
/builds/
packer/boot-*/

# Ignorar artefatos do Packer na pasta packer
/packer/*.box
/packer/packer.log

# Ignorar arquivos temporários do Vagrant
.vagrant/
.signing_key.pub

infra/oci/terraform.tfvars

# Ansible generated inventory (dynamic IPs, should not be committed)
infra/oci/hosts.ini

# Python cache
__pycache__/
*.pyc
*.pyo

# Python coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/

# QA audit evidence artifacts (generated locally)
.qa/

# Benchmark artifacts (transient)
.benchmarks/results.json

# ArgoCD SSH private keys (NEVER commit private keys to VCS)
k8s/gitops/ssh/*
!k8s/gitops/ssh/.gitkeep
!k8s/gitops/ssh/README.md
!k8s/gitops/ssh/*.pub

# Ralph Wiggum Loop (autonomous execution artifacts)
.ralph/*
!.ralph/PROMPT.md
!.ralph/ralph.sh
!.ralph/.gitkeep
DEPLOYMENT-SUMMARY.md


# Mise local configuration (never commit!)
mise.toml.local


# Temporary plaintext secrets (never commit!)
plain_secret*.yaml
temp_*.yaml
*_plaintext.yaml

# ArgoCD manifest cache (download via: make argocd-manifest-fetch)
ansible/roles/argocd/files/argocd-*-install.yaml
coverage.json
.claude/
