#!/bin/bash
set -euo pipefail

# Logging setup
exec > >(tee /var/log/user-data.log)
exec 2>&1

echo "=== k3s Node Setup Started at $(date) ==="
echo "Node Index: ${node_index}"
echo "Node Type: ${node_type}"
echo "k3s Version: ${k3s_version}"

# System updates
echo "[1/7] Updating system packages..."
dnf update -y

# Install required packages (use curl-minimal already present on AL2023)
echo "[2/7] Installing required packages..."
dnf install -y \
  wget \
  git \
  jq \
  htop \
  iptables \
  amazon-ssm-agent \
  container-selinux

# Disable swap (required for k3s)
echo "[3/7] Disabling swap..."
swapoff -a
sed -i '/ swap / s/^/#/' /etc/fstab || true

# Configure kernel modules for k3s
echo "[4/7] Configuring kernel modules..."
cat <<EOF | tee /etc/modules-load.d/k3s.conf
overlay
br_netfilter
EOF

modprobe overlay
modprobe br_netfilter

# Configure sysctl for k3s
cat <<EOF | tee /etc/sysctl.d/k3s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

sysctl --system

# ==============================================================================
# Install Tailscale (Zero Trust mesh network for hybrid cluster)
# ==============================================================================
echo "[5/7] Installing Tailscale..."
curl -fsSL https://tailscale.com/install.sh | sh

echo "[6/7] Starting Tailscale and joining tailnet..."
systemctl enable --now tailscaled
systemctl enable --now amazon-ssm-agent

# Join the tailnet with the auth key
# --advertise-tags: tag nodes for ACL policies
# --accept-routes: accept routes from other tailnet nodes
# --hostname: set a recognizable hostname in the tailnet
tailscale up \
  --authkey="${tailscale_auth_key}" \
  --hostname="k3s-${node_type}-${node_index}" \
  --accept-routes \
  --ssh \
  --reset

# Wait for Tailscale to get an IP
echo "Waiting for Tailscale IP..."
TAILSCALE_IP=""
for i in $(seq 1 30); do
  TAILSCALE_IP=$(tailscale ip -4 2>/dev/null || true)
  if [ -n "$TAILSCALE_IP" ]; then
    echo "Tailscale IP: $TAILSCALE_IP"
    break
  fi
  echo "Waiting for Tailscale IP... ($i/30)"
  sleep 2
done

if [ -z "$TAILSCALE_IP" ]; then
  echo "ERROR: Failed to get Tailscale IP after 60 seconds"
  exit 1
fi

# ==============================================================================
# Install k3s with Tailscale as flannel interface
# ==============================================================================
echo "[7/7] Installing k3s ${k3s_version}..."

%{ if node_type == "server" ~}
# Install k3s server (control plane) with Tailscale networking
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" \
  K3S_TOKEN="${k3s_token}" \
  INSTALL_K3S_EXEC="server" \
  sh -s - \
  --flannel-iface=tailscale0 \
  --node-ip="$TAILSCALE_IP" \
  --advertise-address="$TAILSCALE_IP" \
  --tls-san="$TAILSCALE_IP" \
  --disable traefik \
  --disable servicelb \
  --write-kubeconfig-mode 0600 \
  --node-name "k3s-server-${node_index}" \
  --node-label "node.kubernetes.io/instance-type=t3.small" \
  --node-label "topology.kubernetes.io/zone=$(ec2-metadata --availability-zone | cut -d' ' -f2)" \
  --node-label "kubernetes.io/arch=amd64"

# Wait for k3s to be ready
echo "Waiting for k3s server to be ready..."
until kubectl get nodes 2>/dev/null; do
  sleep 5
done

echo "k3s server installation complete!"
echo "Tailscale IP: $TAILSCALE_IP"
echo "Retrieve kubeconfig with: scp ec2-user@$TAILSCALE_IP:/etc/rancher/k3s/k3s.yaml ~/.kube/config"

%{ else ~}
# Install k3s agent (worker node) with Tailscale networking
# Resolve server IP dynamically via Tailscale — no static IP needed from Terraform
echo "Waiting for k3s server '${server_hostname}' to appear in Tailscale network..."
SERVER_IP=""
for i in $(seq 1 60); do
  SERVER_IP=$(tailscale ip --ip4 "${server_hostname}" 2>/dev/null | head -1 || true)
  if [ -n "$SERVER_IP" ]; then
    echo "Found server at Tailscale IP: $SERVER_IP"
    break
  fi
  echo "Server not in Tailscale yet, retrying in 10s... ($i/60)"
  sleep 10
done

if [ -z "$SERVER_IP" ]; then
  echo "ERROR: Server '${server_hostname}' not found in Tailscale after 10 minutes"
  exit 1
fi

echo "Waiting for k3s API at $SERVER_IP:6443..."
until curl -sk "https://$SERVER_IP:6443/ping" 2>/dev/null; do
  echo "k3s API not ready yet, retrying in 10s..."
  sleep 10
done

curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" \
  K3S_TOKEN="${k3s_token}" \
  K3S_URL="https://$SERVER_IP:6443" \
  INSTALL_K3S_EXEC="agent" \
  sh -s - \
  --flannel-iface=tailscale0 \
  --node-ip="$TAILSCALE_IP" \
  --node-name "k3s-agent-${node_index}" \
  --node-label "node.kubernetes.io/instance-type=t3.small" \
  --node-label "topology.kubernetes.io/zone=$(ec2-metadata --availability-zone | cut -d' ' -f2)" \
  --node-label "kubernetes.io/arch=amd64"

echo "k3s agent installation complete!"
echo "Tailscale IP: $TAILSCALE_IP"
%{ endif ~}

# Enable k3s service
systemctl enable k3s || systemctl enable k3s-agent

echo "=== k3s Node Setup Completed at $(date) ==="
