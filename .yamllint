extends: default

rules:
  # Disable line length check (conflicts with long K8s resource names/URLs)
  line-length: disable

  # Allow document start without --- (common in simple K8s files)
  document-start: disable

  # Allow flexible truthy values (on/off/yes/no) which are common in Ansible
  truthy: disable

  # Allow comments to not strictly require a space after #
  comments:
    min-spaces-from-content: 1
