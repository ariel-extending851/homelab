extends: default

# Ignore Helm templates (Go template syntax is not valid YAML)
ignore: |
  k8s/charts/*/templates/
  **/*.sops.yml
  **/*.sops.yaml
  k8s/apps/**/*secret*.yaml

rules:
  # Disable line length check (conflicts with long K8s resource names/URLs)
  line-length: disable

  # Allow document start without --- (common in simple K8s files)
  document-start: disable

  # Allow flexible truthy values (on/off/yes/no) which are common in Ansible
  truthy: disable

  # Allow comments to not strictly require a space after #
  comments:
    min-spaces-from-content: 1

  # Allow spaces inside braces — required for Ansible inline-dict loop syntax:
  #   loop:
  #     - { key: 'vm.swappiness', value: '{{ swap.swappiness }}' }
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1

  # Allow both indented and non-indented sequences.
  # Kustomization files use `resources:\n- item` (no indent) by convention;
  # Ansible tasks use the indented form. Both are valid YAML.
  indentation:
    spaces: 2
    indent-sequences: whatever
    check-multi-line-strings: false
