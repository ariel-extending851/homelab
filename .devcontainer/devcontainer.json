{
    "name": "Homelab Platform Engine",
    "runArgs": ["--network=host"],
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers-extra/features/mise:1": {},
	"ghcr.io/devcontainers-extra/features/tailscale:1": {}
    },
    "mounts": [
        "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
	"source=opencode-data,target=/home/vscode/.local/share/opencode,type=volume",
        "source=${localEnv:HOME}/.config/sops,target=/home/vscode/.config/sops,type=bind,consistency=cached"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "hashicorp.terraform",
                "ms-azuretools.vscode-docker",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "redhat.vscode-yaml",
                "eamodio.gitlens",
                "github.copilot",
                "vscodevim.vim"
            ],
            "settings": {
                "vscode-neovim.neovimExecutablePaths.linux": "/home/vscode/.local/share/mise/shims/nvim",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "remoteEnv": {
        "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
        "BW_SESSION": "${localEnv:BW_SESSION}",
        "NODE_OPTIONS": "--dns-result-order=ipv4first"
    },
    "postCreateCommand": "mise trust && mise reshim && mise x -- make setup && mise run install-ssm-plugin",
    "remoteUser": "vscode"
}
