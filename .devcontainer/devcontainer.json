{
    "name": "Homelab Platform Engine",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..", // Importante: Permite copiar o .mise.toml da raiz
        "args": { "USERNAME": "dev" }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "hashicorp.terraform",
                "fwcd.kotlin",
                "vscjava.vscode-java-pack",
                "ms-azuretools.vscode-docker",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "redhat.vscode-yaml",
                "esbenp.prettier-vscode",
                "eamodio.gitlens",
                "github.copilot",
                "asvetliakov.vscode-neovim"
            ],
            "settings": {
                "vscode-neovim.neovimExecutablePaths.linux": "/home/dev/.local/share/mise/shims/nvim",
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "remoteEnv": {
        "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
    },
    
    "remoteUser": "dev",

    "postCreateCommand": "mise trust && (test -d ~/.config/nvim || git clone https://github.com/LazyVim/starter ~/.config/nvim) && /home/dev/.local/share/mise/shims/nvim --headless +LazySync +qa"
}
