# {{ ansible_managed }}
# Grafana Alloy systemd unit — native (non-containerized) deployment.
# Capabilities scoped for Beyla eBPF + journal access without full root.

[Unit]
Description=Grafana Alloy unified observability agent
Documentation=https://grafana.com/docs/alloy/
After=network-online.target docker.service
Wants=network-online.target
# Don't block boot if docker isn't installed (RPi 3 may not have it)
Requires=network-online.target

[Service]
Type=simple
User={{ alloy_user }}
Group={{ alloy_user }}
EnvironmentFile=/etc/default/alloy

# Beyla eBPF probes need these capabilities. Avoiding full privilege +
# NoNewPrivileges=false lets `bpf()`, perf_event_open(), and PTRACE work
# without granting the process the entire root capability set.
# CAP_NET_RAW intentionally NOT included — Beyla's HTTP/TCP RED probes
# run as uprobes / tracepoints, not raw socket capture (see Falco's
# matching cap list in k8s/apps/falco/daemonset.yaml).
AmbientCapabilities=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=false

# Beyla pins eBPF maps; the kernel charges them against RLIMIT_MEMLOCK.
LimitMEMLOCK=infinity
LimitNOFILE=1048576

# Memory ceiling — tight on RPi 3 (300M), generous on RPi 4 / EC2 (1G).
# Overridden from group_vars when the default is wrong for a host.
MemoryMax={{ alloy_memory_max }}
MemoryHigh={{ alloy_memory_max }}

ExecStart=/usr/local/bin/alloy run \
    --server.http.listen-addr=0.0.0.0:{{ alloy_http_port }} \
    --storage.path=/var/lib/alloy \
    /etc/alloy/config.alloy

Restart=on-failure
RestartSec={{ alloy_restart_sec }}s
TimeoutStopSec=30s

# Filesystem isolation — Beyla still needs /sys/kernel/debug + /proc rw views,
# so we cannot use ProtectKernelTunables=yes. ProtectSystem=full is the
# tightest setting compatible with /var/lib/alloy WAL writes.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/alloy /etc/alloy

[Install]
WantedBy=multi-user.target
