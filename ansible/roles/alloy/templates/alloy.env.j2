# {{ ansible_managed }}
# Alloy systemd environment file. SOPS-decrypted values arrive via
# ansible/group_vars/alloy.sops.yaml; defaults live in defaults/main.yml.
# Mode 0640, owned by root:alloy — readable by the daemon only.

# ── Grafana Cloud authentication ────────────────────────────────────────────
GRAFANA_CLOUD_PROM_URL={{ alloy_grafana_cloud_prom_url }}
GRAFANA_CLOUD_LOKI_URL={{ alloy_grafana_cloud_loki_url }}
GRAFANA_CLOUD_USER={{ alloy_grafana_cloud_user }}
GRAFANA_CLOUD_TOKEN={{ alloy_grafana_cloud_token }}

# ── Telemetry labels ────────────────────────────────────────────────────────
ALLOY_CLUSTER={{ alloy_cluster_label }}
ALLOY_TIER={{ alloy_tier_label }}
ALLOY_NODE={{ inventory_hostname }}

# ── AWS S3 cold-storage exporter ────────────────────────────────────────────
# Bucket name is sourced from `terraform output -raw observability_bucket_id`.
# Authentication on EC2 is via IAM Instance Profile (IMDSv2); these vars stay
# unset on Raspberry Pi (no AWS credentials path).
AWS_REGION={{ alloy_s3_region }}
ALLOY_S3_BUCKET={{ alloy_s3_bucket }}
ALLOY_S3_EXPORT_ENABLED={{ alloy_enable_s3_export | string | lower }}
