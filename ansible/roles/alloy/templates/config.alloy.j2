// {{ ansible_managed }}
// Grafana Alloy unified observability configuration (River language).
//
// Topology — multi-cast fan-out:
//
//   sources (discovery + scrape + journal + docker)
//        │
//        ├──► prometheus.relabel.cardinality_guard  ──►  prometheus.remote_write.grafana_cloud
//        │
//        └──► loki.process.normalize  ──►  loki.write.grafana_cloud_loki
//                                     │
//                                     └──►  otelcol.receiver.loki.cold_archive
//                                              │
//                                              └──► otelcol.exporter.awss3 (S3 Deep-Archive tier)
//
// Compliance: workload labels derive ONLY from container annotation
// `homelab.io/class` (taxonomy: containerized_microservice |
// media_streaming_daemon | high_throughput_local_service). Defensive drop
// rule at the bottom of the cardinality_guard catches any leak of forbidden
// product names. A CI contract test enforces this at the repo level
// (bin/tests/test_no_forbidden_workload_names.py).

logging {
  level  = "{{ alloy_log_level }}"
  format = "{{ alloy_log_format }}"
}

livedebugging {
  enabled = true
}

// ============================================================================
// HOST + APP METRICS
// ============================================================================

// Node-Exporter equivalent — host CPU / memory / disk / network / sysctl.
// `mountstats` collector is dropped on the Pi to save memory; cAdvisor is
// gated entirely (high cardinality).
prometheus.exporter.unix "host" {
  set_collectors = [
    "cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev",
    "netstat", "stat", "time", "uname", "vmstat", "filefd", "pressure",
  ]
}

{% if alloy_enable_cadvisor %}
prometheus.exporter.cadvisor "containers" {
  // High-cardinality labels (`id`, `name`) are dropped at the relabel stage
  // before they reach Grafana Cloud — see cardinality_guard below.
  docker_only = true
}
{% endif %}

{% if alloy_enable_beyla %}
// eBPF zero-instrumentation: HTTP/HTTPS/gRPC/TCP RED metrics + service graph.
// Discovery selects by port range and namespace; service-name allowlists are
// forbidden (compliance) — workloads identify themselves via the
// `homelab.io/class` container label, which becomes the `service_class` label.
//
// beyla.ebpf.output.metrics expects otelcol.Consumer; prometheus.relabel
// receiver is storage.Appendable. Bridge via otelcol.exporter.prometheus.
beyla.ebpf "red" {
  output {
    metrics = [otelcol.exporter.prometheus.beyla_bridge.input]
  }

  // TODO: re-add URL path exclusion via `routes { ignored_patterns = [...] }`
  // (the original `attributes.select` block was invalid for Alloy v1.5.1).

  discovery {
    services {
      open_ports = "80,443,3000,3100,4317,4318,8080,8081,8443,9090,9100,12345"
      // Names matched via container label only (never by image / container name).
      // The label is set by the workload's docker-compose:
      //     labels:
      //       homelab.io/class: containerized_microservice
      kubernetes {
        namespace = ".*"
      }
    }
  }
}

// Bridge: OTLP (beyla.ebpf) → native Prometheus (cardinality_guard).
otelcol.exporter.prometheus "beyla_bridge" {
  forward_to = [prometheus.relabel.cardinality_guard.receiver]
}
{% endif %}

// Scrape Alloy's own exposition + the local exporters above.
prometheus.scrape "self" {
  targets = [{
    __address__ = "127.0.0.1:{{ alloy_http_port }}",
    job         = "alloy",
  }]
  forward_to      = [prometheus.relabel.cardinality_guard.receiver]
  scrape_interval = "30s"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.cardinality_guard.receiver]
  scrape_interval = "30s"
}

{% if alloy_enable_cadvisor %}
prometheus.scrape "cadvisor" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  forward_to      = [prometheus.relabel.cardinality_guard.receiver]
  scrape_interval = "60s"
}
{% endif %}

// ============================================================================
// CARDINALITY + COMPLIANCE GUARD
// ============================================================================
// 1. Inject `cluster` and `tier` static labels via external_labels on the
//    remote_write block (cheaper than a relabel pass).
// 2. Drop high-cardinality cAdvisor labels (`id`, `name`).
// 3. Drop any series whose `service` / `job` / `container_name` label
//    matches the forbidden product names — defensive belt-and-braces.

prometheus.relabel "cardinality_guard" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Drop the noisy cgroup `id` label that cAdvisor emits.
  rule {
    action        = "labeldrop"
    regex         = "id|name|container_label_io_kubernetes_.*|annotation_.*"
  }

  // Compliance: drop any series whose user-visible label matches the
  // forbidden product name regex. Sourced from `alloy_forbidden_label_regex`.
  rule {
    source_labels = ["service"]
    regex         = "{{ alloy_forbidden_label_regex }}"
    action        = "drop"
  }
  rule {
    source_labels = ["job"]
    regex         = "{{ alloy_forbidden_label_regex }}"
    action        = "drop"
  }
  rule {
    source_labels = ["container_name"]
    regex         = "{{ alloy_forbidden_label_regex }}"
    action        = "drop"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
    // Survives Grafana Cloud outages without back-pressuring scrapes.
    queue_config {
      capacity            = 10000
      max_shards          = 10
      max_samples_per_send = 2000
      batch_send_deadline = "5s"
    }
  }

  external_labels = {
    cluster = sys.env("ALLOY_CLUSTER"),
    tier    = sys.env("ALLOY_TIER"),
    node    = sys.env("ALLOY_NODE"),
  }

  // On-disk WAL — sized per node by the systemd unit's storage.path arg.
  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

// ============================================================================
// LOGS — discovery, processing, fan-out
// ============================================================================

{% if alloy_enable_docker_logs %}
// Discover running containers via the Docker socket. The relabel block
// promotes the compliance label (`homelab.io/class`) to a `service_class`
// telemetry label; container names are explicitly NOT promoted.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_homelab_io_class"]
    target_label  = "service_class"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
  // Drop the container name from the label set — compliance requires that
  // we never surface workload product names. Operators query by service_class.
  rule {
    // Drop only post-resolution `container_name`; loki.source.docker needs
    // __meta_docker_container_name to resolve targets. Compliance enforced
    // at sink (loki.process.normalize).
    action = "labeldrop"
    regex  = "^container_name$"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  forward_to       = [loki.process.normalize.receiver]
  refresh_interval = "30s"
}
{% endif %}

{% if alloy_enable_journal %}
loki.source.journal "system" {
  forward_to    = [loki.process.normalize.receiver]
  relabel_rules = loki.relabel.journal.rules
  // TODO: re-add systemd unit filter. Alloy `matches` is space-AND; use `+`
  // for OR per systemd journal native syntax. For now ingest all entries.
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
}
{% endif %}

loki.process "normalize" {
  forward_to = [
    loki.write.grafana_cloud_loki.receiver,
{% if alloy_enable_s3_export %}
    otelcol.receiver.loki.cold_archive.receiver,
{% endif %}
  ]

  // Static labels — cluster + tier dimensions. Per-line labels come from the
  // discovery_relabel block above (service_class) and the journal rules.
  stage.static_labels {
    values = {
      cluster = "{{ alloy_cluster_label }}",
      tier    = "{{ alloy_tier_label }}",
      node    = "{{ inventory_hostname }}",
    }
  }

  // Best-effort JSON parse for structured log lines (k3s, alloy, etc).
  stage.json {
    expressions = {
      level    = "level",
      trace_id = "trace_id",
    }
  }
  stage.labels {
    values = {
      level = "",
    }
  }

  // Defensive: drop log lines whose extracted service label leaks a forbidden
  // product name (mirrors the metrics guard).
  stage.match {
    selector = `{service_class=~".+"}`
    stage.drop {
      source     = "service"
      expression = "{{ alloy_forbidden_label_regex }}"
      drop_counter_reason = "forbidden_workload_name_leak"
    }
  }
}

loki.write "grafana_cloud_loki" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      // Grafana Cloud assigns separate Instance IDs per service.
      // Prom user lives in GRAFANA_CLOUD_USER (Hosted Metrics card),
      // Loki user lives in GRAFANA_CLOUD_LOKI_USER (Hosted Logs card).
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
  external_labels = {
    cluster = sys.env("ALLOY_CLUSTER"),
    tier    = sys.env("ALLOY_TIER"),
  }
}

{% if alloy_enable_s3_export %}
// ============================================================================
// S3 COLD-STORAGE SUB-PIPELINE (EC2 only — IAM Instance Profile auth)
// ============================================================================
// Loki frames are converted to OTLP, batched at 5-minute intervals or
// 5 MiB (whichever first), gzip-compressed, and partitioned by minute
// for cheap S3 LIST scans.

otelcol.receiver.loki "cold_archive" {
  output {
    logs = [otelcol.processor.batch.cold_archive.input]
  }
}

otelcol.processor.batch "cold_archive" {
  timeout         = "5m"
  send_batch_size = 8192
  output {
    logs = [otelcol.processor.attributes.cold_archive.input]
  }
}

otelcol.processor.attributes "cold_archive" {
  action {
    key    = "cluster"
    action = "insert"
    value  = sys.env("ALLOY_CLUSTER")
  }
  action {
    key    = "tier"
    action = "insert"
    value  = sys.env("ALLOY_TIER")
  }
  output {
    logs = [otelcol.exporter.awss3.cold_archive.input]
  }
}

otelcol.exporter.awss3 "cold_archive" {
  s3_uploader {
    region            = sys.env("AWS_REGION")
    s3_bucket         = sys.env("ALLOY_S3_BUCKET")
    s3_prefix         = "alloy"
    s3_partition      = "minute"
    file_prefix       = "logs-"
    compression       = "gzip"
    // Authentication is implicit via the EC2 IAM Instance Profile (IMDSv2
    // hop_limit = 2). No access keys appear in this config or anywhere
    // else on the node.
  }

  marshaler {
    type = "otlp_proto"
  }

  // sending_queue block added in Alloy >= 1.6; not supported in v1.5.1.
  // Default internal queue is fine for homelab volume.
}
{% endif %}
