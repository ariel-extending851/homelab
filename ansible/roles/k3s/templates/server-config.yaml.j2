# k3s server configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# Managed by: ansible/roles/k3s/templates/server-config.yaml.j2

write-kubeconfig-mode: "{{ k3s_server_config.write_kubeconfig_mode | default('0644') }}"
cluster-cidr: "{{ k3s_server_config.cluster_cidr | default('10.42.0.0/16') }}"
service-cidr: "{{ k3s_server_config.service_cidr | default('10.43.0.0/16') }}"

{% if k3s_server_config.tls_san | default([]) | length > 0 %}
tls-san:
{% for san in k3s_server_config.tls_san %}
  - {{ san }}
{% endfor %}
{% endif %}

{% if k3s_server_config.disable | default([]) | length > 0 %}
disable:
{% for component in k3s_server_config.disable %}
  - {{ component }}
{% endfor %}
{% endif %}

{% if enable_cilium_cni | default(false) | bool %}
flannel-backend: none
{% else %}
flannel-backend: "{{ k3s_server_config.flannel_backend | default('vxlan') }}"
{% endif %}

{% if k3s_server_config.disable_cloud_controller | default(true) %}
disable-cloud-controller: true
{% endif %}

{% if (enable_cilium_cni | default(false) | bool) or (k3s_server_config.disable_network_policy | default(false) | bool) %}
disable-network-policy: true
{% endif %}

{% if k3s_enable_etcd_snapshots %}
etcd-snapshot-schedule-cron: "{{ k3s_etcd_snapshot_schedule }}"
etcd-snapshot-retention: {{ k3s_etcd_snapshot_retention }}
{% endif %}

{% if k3s_secrets_encryption %}
secrets-encryption: true
{% endif %}

{% if k3s_protect_kernel_defaults %}
protect-kernel-defaults: true
{% endif %}

# Node name (use stable inventory_hostname)
node-name: {{ k3s_node_name }}
