# k3s agent configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# Managed by: ansible/roles/k3s/templates/agent-config.yaml.j2

# Node name (use stable inventory_hostname)
node-name: {{ k3s_node_name }}

# Tailscale network binding — forces kubelet and flannel to use the Tailscale
# interface so that all in-cluster communication (including log proxying) uses
# the encrypted overlay network instead of the raw AWS VPC interface.
{% if k3s_tailscale_ip is defined and k3s_tailscale_ip | length > 0 %}
node-ip: {{ k3s_tailscale_ip }}
{% if not (enable_cilium_cni | default(false) | bool) %}
flannel-iface: tailscale0
{% endif %}
{% endif %}

{% if k3s_agent_config.node_label | default([]) | length > 0 %}
node-label:
{% for label in k3s_agent_config.node_label %}
  - {{ label }}
{% endfor %}
{% endif %}

{% if k3s_agent_config.node_taint | default([]) | length > 0 %}
node-taint:
{% for taint in k3s_agent_config.node_taint %}
  - {{ taint }}
{% endfor %}
{% endif %}

{% if k3s_protect_kernel_defaults %}
protect-kernel-defaults: true
{% endif %}
