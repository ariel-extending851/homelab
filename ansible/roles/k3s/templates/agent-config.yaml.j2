# k3s agent configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# Managed by: ansible/roles/k3s/templates/agent-config.yaml.j2

# Node name (use hostname)
node-name: {{ ansible_hostname }}

{% if k3s_agent_config.node_label | default([]) | length > 0 %}
node-label:
{% for label in k3s_agent_config.node_label %}
  - {{ label }}
{% endfor %}
{% endif %}

{% if k3s_agent_config.node_taint | default([]) | length > 0 %}
node-taint:
{% for taint in k3s_agent_config.node_taint %}
  - {{ taint }}
{% endfor %}
{% endif %}

{% if k3s_protect_kernel_defaults %}
protect-kernel-defaults: true
{% endif %}
