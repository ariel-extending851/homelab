/var/log/pods/*/*.log {
    {{ log_rotation.compress | ternary('compress', 'nocompress') }}
    daily
    rotate {{ log_rotation.max_files }}
    missingok
    notifempty
    maxsize {{ log_rotation.max_size }}
    create 0644 root root
    su root root
}

/var/lib/rancher/k3s/agent/containerd/containerd.log {
    {{ log_rotation.compress | ternary('compress', 'nocompress') }}
    daily
    rotate {{ log_rotation.max_files }}
    missingok
    notifempty
    maxsize {{ log_rotation.max_size }}
    create 0644 root root
    sharedscripts
    postrotate
        systemctl reload k3s-agent > /dev/null 2>&1 || true
    endscript
}
